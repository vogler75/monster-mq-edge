# Bootstrap configuration of the broker embedded in the WinCC OA manager
# (WCCOAmmq). Copy to <project>/config/monstermq.yaml; the manager
# reads it through the [monstermq] brokerConfig entry.
NodeId: edge-oa-1
Logging:
  Level: INFO                   # DEBUG logs every WinCC OA call (dpConnect, dpQueryConnectSingle with the query, dpSetWait, ...)
TCP:
  Enabled: true
  Port: 1883
GraphQL:
  Enabled: true
  Port: 4000
SQLite:
  Path: ./data/monstermq.db     # relative to the WinCC OA project directory
DefaultStoreType: SQLITE
ConfigStoreType: WINCCOA        # device and archive configs in MMQConfigs datapoints (or SQLITE)
SessionStoreType: WINCCOA       # sessions and subscriptions in MMQSessions datapoints (or SQLITE, MEMORY)
RetainedStoreType: SQLITE       # retained messages: SQLITE (default), WINCCOA (MMQRetained datapoints) or MEMORY (lost on restart)
QueueStoreType: SQLITE          # offline messages of persistent sessions: SQLITE or MEMORY
Features:
  WinCCOa: true                 # run WinCCOA-Client query devices
WinCCOaNative:
  Enabled: true
  Namespace: true               # winccoa/<system>/tags|types, validated subscriptions, writes
  TopicRoot: winccoa            # first topic level(s); the status topic is <TopicRoot>/<system>
  TagsName: tags                # <TopicRoot>/<system>/<TagsName>/<dp>/<element>...
  TypesName: types              # <TopicRoot>/<system>/<TypesName>/<dpt>/<dp>/<element>...
  EchoPolicy: BROKER_TAG
UserManagement:
  Enabled: true                 # recommended: ACLs gate native reads and writes
  AnonymousEnabled: false
